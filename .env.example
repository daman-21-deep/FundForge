# FundForge Stellar/Soroban Environment Configuration
# Copy this file to .env or .env.local for local development.

# Soroban Campaign Registry Contract Address deployed on Stellar Testnet
VITE_REGISTRY_CONTRACT="CCGXNGQBDWTS5NRHD4ZOHUN6GL3JKSX225UWX77353V4P7LAHNHT3BPN"

# Funding Escrow WASM Hash installed on Stellar Testnet for dynamic campaign deployment
VITE_ESCROW_WASM_HASH="059d15d51c418db21193155e63f0d06938b9dcf31ddbc08199d39431a68fb352"

# Network Configuration
# Supported Options: TESTNET | FUTURENET | PUBLIC (MAINNET)
VITE_STELLAR_NETWORK="TESTNET"

# Stellar Testnet Horizon URL & RPC Endpoint
VITE_RPC_URL="https://soroban-testnet.stellar.org"
VITE_HORIZON_URL="https://horizon-testnet.stellar.org"
VITE_NETWORK_PASSPHRASE="Test SDF Network ; July 2015"

# Optional: Mainnet Endpoints (Uncomment for Production Mainnet Deployment)
# VITE_STELLAR_NETWORK="PUBLIC"
# VITE_RPC_URL="https://rpc.mainnet.stellar.org"
